{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {{ form_start(configForm) }}
  <div class="card">
    <h3 class="card-header">
      <i class="material-icons">settings</i> {{ 'Text form types'|trans({}, 'Modules.Shopeame.Admin') }}
    </h3>
    <div class="card-body">
      <div style="text-align: center">
        <p>
          {{ 'Follow Shopea.me instructions to configure this form.'|trans({}, 'Modules.Shopeame.Admin') }}
        </p>
      </div>
      <div class="form-wrapper">
        {{ form_widget(configForm) }}
      </div>
    </div>
    <div class="card-footer">
      <div class="d-flex justify-content-end">
        <a href="{{ path('shopeame_generate_api_key') }}" class="btn btn-secondary" id="generate-api-key-button">
          {% if apiKey is defined and apiKey is not empty %}
            {{ 'Regenerate API Key'|trans({}, 'Modules.Shopeame.Admin') }}
          {% else %}
            {{ 'Generate API Key'|trans({}, 'Modules.Shopeame.Admin') }}
          {% endif %}
        </a>
        <button class="btn btn-primary float-right" id="save-button">
          {{ 'Save'|trans({}, 'Admin.Actions') }}
        </button>
        <a href="{{ path('shopeame_register_shop') }}" class="btn btn-primary" id="register-shop-btn" style="display: none; margin-left: 5px;">
          {{ 'Register Shop'|trans({}, 'Modules.Shopeame.Admin') }}
        </a>
      </div>
    </div>
  </div>
  {{ form_end(configForm) }}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    // mostrar botón si está el formulario OK
    const canRegister = {{ canEnableRegisterButton ? 'true' : 'false' }};
    if (canRegister) {
      const registerBtn = document.getElementById('register-shop-btn');
      registerBtn.style.display = 'inline-block';
    }
    // document.addEventListener('DOMContentLoaded', () => {
      
    // });
  </script>
{% endblock %}
