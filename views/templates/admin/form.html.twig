{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {% if registeredShop %}
    {# ===== Tienda vinculada ===== #}
    <div class="card mb-3">
      <h3 class="card-header">
        <i class="material-icons">check_circle</i> {{ 'Tienda vinculada'|trans({}, 'Modules.Shopeame.Admin') }}
      </h3>
      <div class="card-body">
        <p>
          {{ 'La tienda %url% está vinculada con shopea.me. Sus pedidos se sincronizan automáticamente.'|trans({'%url%': shopUrl}, 'Modules.Shopeame.Admin') }}
          <a href="{{ shopLinkUrl }}" target="_blank">{{ 'Ver la tienda en shopea.me'|trans({}, 'Modules.Shopeame.Admin') }}</a>.
        </p>
      </div>
    </div>

    <div class="card">
      <h3 class="card-header">
        <i class="material-icons">settings</i> {{ 'Acciones'|trans({}, 'Modules.Shopeame.Admin') }}
      </h3>
      <div class="card-body">
        <a href="{{ path('shopeame_check_shop') }}" class="btn btn-secondary" style="margin-right:5px;">
          {{ 'Comprobar conexión'|trans({}, 'Modules.Shopeame.Admin') }}
        </a>
        <form method="post" action="{{ path('shopeame_unlink_shop') }}" class="d-inline-block" style="margin-right:5px;"
              onsubmit="return confirm('{{ 'Esta acción desvinculará la tienda de Shopeame. ¿Quieres continuar?'|trans({}, 'Modules.Shopeame.Admin')|e('js') }}');">
          <input type="hidden" name="_token" value="{{ csrf_token('shopeame_shop_actions') }}">
          <button type="submit" class="btn btn-danger">
            {{ 'Desvincular tienda'|trans({}, 'Modules.Shopeame.Admin') }}
          </button>
        </form>
        <form method="post" action="{{ path('shopeame_clear_local_shop') }}" class="d-inline-block"
              onsubmit="return confirm('{{ 'Esta acción solo borrará los datos de conexión guardados en la app y no modificará Shopeame. ¿Quieres continuar?'|trans({}, 'Modules.Shopeame.Admin')|e('js') }}');">
          <input type="hidden" name="_token" value="{{ csrf_token('shopeame_shop_actions') }}">
          <button type="submit" class="btn btn-outline-danger">
            {{ 'Borrar datos de la app'|trans({}, 'Modules.Shopeame.Admin') }}
          </button>
        </form>
      </div>
    </div>
  {% else %}
    {# ===== No vinculada =====
       Nota: no mostramos el resultado del check_shop automático aquí. Mientras la tienda no está
       registrada, el UUID/token guardados son los del ERP (Opción 2), así que el check devuelve
       "unauthorized" de forma esperada; mostrarlo como error confundía al usuario. #}
    <p>
      {{ 'Conecta tu tienda PrestaShop con shopea.me. Para ello necesitas tener previamente registrado tu ERP en shopea.me. Después tienes dos formas de vincularla.'|trans({}, 'Modules.Shopeame.Admin') }}
    </p>

    {# ----- Opción 1: copiar los datos en shopea.me ----- #}
    <div class="card mb-3">
      <h3 class="card-header">
        {{ 'Opción 1: copiar los datos en shopea.me'|trans({}, 'Modules.Shopeame.Admin') }}
      </h3>
      <div class="card-body">
        <p>{{ 'Copia estos datos y pégalos en shopea.me al conectar una tienda de tipo PrestaShop.'|trans({}, 'Modules.Shopeame.Admin') }}</p>
        <table class="table">
          <tbody>
            <tr>
              <th style="width:260px;">{{ 'URL de la tienda'|trans({}, 'Modules.Shopeame.Admin') }}</th>
              <td>
                <code id="shopeame-url">{{ shopUrl }}</code>
                <button type="button" class="btn btn-secondary btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('shopeame-url').textContent)">
                  {{ 'Copiar'|trans({}, 'Modules.Shopeame.Admin') }}
                </button>
              </td>
            </tr>
            <tr>
              <th>{{ 'Clave del webservice'|trans({}, 'Modules.Shopeame.Admin') }}</th>
              <td>
                {% if apiKey is not empty %}
                  <code id="shopeame-key">{{ apiKey }}</code>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('shopeame-key').textContent)">
                    {{ 'Copiar'|trans({}, 'Modules.Shopeame.Admin') }}
                  </button>
                {% else %}
                  <em>{{ '— genera la clave de API —'|trans({}, 'Modules.Shopeame.Admin') }}</em>
                {% endif %}
              </td>
            </tr>
          </tbody>
        </table>
        <a href="{{ path('shopeame_generate_api_key') }}" class="btn btn-secondary">
          {% if enableGenerateApiKeyButton %}
            {{ 'Generar clave de API'|trans({}, 'Modules.Shopeame.Admin') }}
          {% else %}
            {{ 'Regenerar clave de API'|trans({}, 'Modules.Shopeame.Admin') }}
          {% endif %}
        </a>
      </div>
    </div>

    {# ----- Opción 2: vincular indicando tu ERP ----- #}
    <div class="card">
      <h3 class="card-header">
        {{ 'Opción 2: vincular indicando tu ERP'|trans({}, 'Modules.Shopeame.Admin') }}
      </h3>
      <div class="card-body">
        <p>{{ 'Introduce el UUID y el token de tu ERP (los obtienes en shopea.me una vez registrado el ERP), guarda y pulsa Registrar tienda.'|trans({}, 'Modules.Shopeame.Admin') }}</p>
        {{ form_start(configForm) }}
          {{ form_row(configForm.SHOPEAME_UUID) }}
          {{ form_row(configForm.SHOPEAME_WEBHOOK_TOKEN) }}
          <button class="btn btn-primary" id="link-button">
            {{ 'Vincular tienda'|trans({}, 'Modules.Shopeame.Admin') }}
          </button>
        {{ form_end(configForm) }}
      </div>
    </div>
  {% endif %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
{% endblock %}
