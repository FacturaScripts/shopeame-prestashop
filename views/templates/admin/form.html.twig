{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {{ form_start(configForm) }}
  <div class="card">
    <h3 class="card-header">
      <i class="material-icons">settings</i> {{ 'Text form types'|trans({}, 'Modules.Shopeame.Admin') }}
    </h3>
    <div class="card-body">
      <div style="text-align: center">
        <p>
          <strong>{{ 'Connection Status'|trans({}, 'Modules.Shopeame.Admin') }}:</strong>
          {% if registeredShop %}
            <span style="color: green;">{{ 'Registered'|trans({}, 'Modules.Shopeame.Admin') }}</span>
          {% elseif errored is not same as(false) %}
            {% if errored == 'unauthorized' %}
              <span style="color: orange;">{{ 'Invalid credentials'|trans({}, 'Modules.Shopeame.Admin') }}</span>
            {% else %}
              <span style="color: red;">{{ 'Error: %error%'|trans({'%error%': errored}, 'Modules.Shopeame.Admin') }}</span>
            {% endif %}
          {% else %}
            <span style="color: red;">{{ 'Not Registered'|trans({}, 'Modules.Shopeame.Admin') }}</span>
          {% endif %}
        </p>
      </div>
      <div style="text-align: center">
        <p>
          {{ 'Follow Shopea.me instructions to configure this form.'|trans({}, 'Modules.Shopeame.Admin') }}
        </p>
      </div>
      <div class="form-wrapper">
        {{ form_widget(configForm) }}
      </div>
    </div>
    <div class="card-footer">
      <div class="d-flex justify-content-end">
        <a href="{{ path('shopeame_generate_api_key') }}" class="btn btn-secondary" id="generate-api-key-button">
          {% if enableGenerateApiKeyButton %}
            {{ 'Generate API Key'|trans({}, 'Modules.Shopeame.Admin') }}
          {% else %}
            {{ 'Regenerate API Key'|trans({}, 'Modules.Shopeame.Admin') }}
          {% endif %}
        </a>
        <button class="btn btn-primary float-right" id="save-button">
          {{ 'Save'|trans({}, 'Admin.Actions') }}
        </button>
        <a href="{{ path('shopeame_register_shop') }}" class="btn btn-primary" id="register-shop-btn" style="display: none; margin-left: 5px;">
          {{ 'Register Shop'|trans({}, 'Modules.Shopeame.Admin') }}
        </a>
      </div>
    </div>
  </div>
  {{ form_end(configForm) }}
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    // mostrar botón si está el formulario OK
    const canRegister = {{ enableRegisterButton ? 'true' : 'false' }};
    if (canRegister) {
      const registerBtn = document.getElementById('register-shop-btn');
      registerBtn.style.display = 'inline-block';
    }

    const enableApiKeyBtn = {{ enableGenerateApiKeyButton ? 'true' : 'false' }};
    if (enableApiKeyBtn) {
      const registerBtn = document.getElementById('generate-api-key-button');
      registerBtn.style.display = 'inline-block';
    }
  </script>
{% endblock %}
