{#
  Pantalla de configuración del módulo Shopeame.

  Replica la estructura y los textos de la app de Shopify (base visual común a los conectores de
  Shopify, WooCommerce y PrestaShop): sección de bienvenida o de tienda vinculada, banner con el
  resultado de la última acción y, después, las opciones de vinculación o las acciones.
#}
{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% trans_default_domain 'Modules.Shopeame.Admin' %}

{# Campo de credencial: etiqueta, valor recortable en monospace y botón "Copiar" en la misma línea #}
{% macro credential_field(id, label, value, emptyText, hint) %}
  <div class="shopeame-field">
    <span class="shopeame-field-label">{{ label }}</span>
    <div class="shopeame-field-row">
      {% if value is not empty %}
        <code class="shopeame-field-value" id="{{ id }}">{{ value }}</code>
        <button type="button" class="btn btn-outline-secondary" data-shopeame-copy="{{ id }}"
                data-shopeame-copied="{{ 'Copied'|trans({}, 'Modules.Shopeame.Admin') }}">
          {{ 'Copy'|trans({}, 'Modules.Shopeame.Admin') }}
        </button>
      {% else %}
        <span class="shopeame-field-value shopeame-field-empty">{{ emptyText }}</span>
      {% endif %}
    </div>
    {% if hint is not empty %}
      <small class="form-text text-muted">{{ hint }}</small>
    {% endif %}
  </div>
{% endmacro %}

{# Los mensajes flash no se pintan arriba: se muestran como banner bajo la primera sección #}
{% block content_header %}{% endblock %}

{% block content %}
  {% import _self as shopeame %}

  <div class="shopeame-page">
    {# ===== Versión nueva publicada en GitHub (ver UpdateChecker) ===== #}
    {% if update %}
      <div class="alert alert-warning shopeame-update-notice" role="alert">
        <p class="alert-text">
          {{ 'A new version of Shopeame is available: %new%. You have version %current%.'|trans({
            '%new%': update.version,
            '%current%': moduleVersion
          }) }}
        </p>
        {% if update.changelog is not empty %}
          <ul class="shopeame-update-changelog">
            {% for line in update.changelog %}
              <li>{{ line }}</li>
            {% endfor %}
          </ul>
        {% endif %}
        <div class="shopeame-actions">
          <form method="post" action="{{ path('shopeame_update_module') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('shopeame_update') }}">
            <button type="submit" class="btn btn-primary">{{ 'Update now'|trans }}</button>
          </form>
          <a href="{{ update.details_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-link">
            {{ 'What’s new'|trans }}
          </a>
        </div>
      </div>
    {% endif %}

    {% if registeredShop %}
      {# ===== Tienda vinculada ===== #}
      <div class="card shopeame-section">
        <div class="card-body">
          <h3 class="shopeame-section-title">{{ 'Linked store ✅'|trans }}</h3>
          <p>
            {{ 'The store %url% is linked with %link%. Its orders are synced automatically.'|trans({
              '%url%': '<strong>' ~ shopUrl|e ~ '</strong>',
              '%link%': '<a href="https://shopea.me" target="_blank" rel="noopener noreferrer">shopea.me</a>'
            })|raw }}
            <a href="{{ shopLinkUrl }}" target="_blank" rel="noopener noreferrer">{{ 'View the store on shopea.me'|trans }}</a>
          </p>
        </div>
      </div>

      {{ block('session_alert') }}

      <div class="card shopeame-section">
        <div class="card-body">
          <h3 class="shopeame-section-title">{{ 'Actions'|trans }}</h3>
          <div class="shopeame-actions">
            <a href="{{ path('shopeame_check_shop') }}" class="btn btn-outline-secondary">
              {{ 'Check connection'|trans }}
            </a>
            <form method="post" action="{{ path('shopeame_unlink_shop') }}"
                  data-shopeame-confirm="{{ 'This will unlink the store from Shopeame. Do you want to continue?'|trans }}">
              <input type="hidden" name="_token" value="{{ csrf_token('shopeame_shop_actions') }}">
              <button type="submit" class="btn btn-danger">{{ 'Unlink store'|trans }}</button>
            </form>
            <form method="post" action="{{ path('shopeame_clear_local_shop') }}"
                  data-shopeame-confirm="{{ 'This will only delete the connection data saved in this module and will not change Shopeame. Do you want to continue?'|trans }}">
              <input type="hidden" name="_token" value="{{ csrf_token('shopeame_shop_actions') }}">
              <button type="submit" class="btn btn-outline-danger">{{ 'Delete module data'|trans }}</button>
            </form>
          </div>
        </div>
      </div>
    {% else %}
      {# ===== No vinculada =====
         Nota: no mostramos el resultado del check_shop automático aquí. Mientras la tienda no está
         registrada, el UUID/token guardados son los del ERP (Opción 2), así que el check devuelve
         "unauthorized" de forma esperada; mostrarlo como error confundía al usuario. #}
      <div class="card shopeame-section">
        <div class="card-body">
          <h3 class="shopeame-section-title">{{ 'Your store is ready to connect 🎉'|trans }}</h3>
          <p>
            {{ 'This module connects your PrestaShop store with %link%. To connect the store you first need to register your ERP on shopea.me. Once registered, there are two ways to link this store.'|trans({
              '%link%': '<a href="https://shopea.me" target="_blank" rel="noopener noreferrer">shopea.me</a>'
            })|raw }}
          </p>
        </div>
      </div>

      {{ block('session_alert') }}

      {# ----- Opción 1: copiar los datos en shopea.me ----- #}
      <div class="card shopeame-section">
        <div class="card-body">
          <h3 class="shopeame-section-title">{{ 'Option 1: copy the data into shopea.me'|trans }}</h3>
          <p>{{ 'Copy the data below and paste it into shopea.me when connecting a PrestaShop store.'|trans }}</p>
          <div class="shopeame-stack">
            {{ shopeame.credential_field('shopeame-url', 'Store URL'|trans, shopUrl, '', '') }}
            {{ shopeame.credential_field(
              'shopeame-key',
              'Webservice key'|trans,
              apiKey,
              'Click “Generate API key” to create it'|trans,
              'Treat this key like a password: anyone who has it can read the orders and products of your store through the PrestaShop webservice.'|trans
            ) }}
          </div>
          <a href="{{ path('shopeame_generate_api_key') }}" class="btn btn-outline-secondary">
            {% if enableGenerateApiKeyButton %}
              {{ 'Generate API key'|trans }}
            {% else %}
              {{ 'Regenerate API key'|trans }}
            {% endif %}
          </a>
        </div>
      </div>

      {# ----- Opción 2: vincular indicando tu ERP ----- #}
      <div class="card shopeame-section">
        <div class="card-body">
          <h3 class="shopeame-section-title">{{ 'Option 2: link using your ERP details'|trans }}</h3>
          <p>{{ 'Enter the UUID and token of your ERP (you get them on shopea.me once the ERP is registered) and this store will be linked automatically.'|trans }}</p>
          {{ form_start(configForm) }}
            <div class="shopeame-stack">
              {% for field in [configForm.SHOPEAME_UUID, configForm.SHOPEAME_WEBHOOK_TOKEN] %}
                {# etiqueta encima y campo a todo el ancho, como en Shopify #}
                <div class="shopeame-field">
                  {{ form_label(field, null, {'label_attr': {'class': 'shopeame-field-label'}}) }}
                  {{ form_widget(field) }}
                  {{ form_errors(field) }}
                </div>
              {% endfor %}
            </div>
            <button type="submit" class="btn btn-primary" id="link-button">
              {{ 'Link store'|trans }}
            </button>
          {{ form_end(configForm) }}
        </div>
      </div>
    {% endif %}

    {# ===== Versión instalada y consulta inmediata de actualizaciones ===== #}
    <p class="shopeame-version">
      {{ 'Shopeame version %version%'|trans({'%version%': moduleVersion}) }}
      · <a href="{{ path('shopeame_check_updates') }}">{{ 'Check for updates'|trans }}</a>
    </p>
  </div>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('../modules/shopeame/views/css/admin.css') }}">
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('../modules/shopeame/views/js/admin.js') }}"></script>
{% endblock %}
