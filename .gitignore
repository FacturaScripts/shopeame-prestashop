.DS_Store
Thumbs.db

# editores
/.idea/
.vscode
*.code-workspace

# dependencias de composer: build.sh genera vendor/ (solo el autoload) al crear el zip
/vendor/

# zip del módulo: lo genera build.sh fuera del repositorio
*.zip

# caché que genera PrestaShop al instalar el módulo
/config.xml
/config_*.xml

