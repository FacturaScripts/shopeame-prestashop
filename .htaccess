# Impide listar el contenido de la carpeta del módulo y acceder directamente a sus archivos PHP:
# PrestaShop los carga siempre desde su propio index.php (incluido el controlador frontal «link»).

# Apache 2.2
<IfModule !mod_authz_core.c>
    <Files *.php>
    order allow,deny
    deny from all
    </Files>
</IfModule>

# Apache 2.4
<IfModule mod_authz_core.c>
    <Files *.php>
    Require all denied
    </Files>
</IfModule>
